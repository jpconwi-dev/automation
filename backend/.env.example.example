# --- Server ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_DIR=storage
MAX_CONCURRENT_JOBS=1
MAX_QUEUE=4

# --- Script (local Ollama) ---
LLM_BACKEND=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=600

# --- Narration (built-in Windows voices, no download) ---
TTS_BACKEND=windows
WINDOWS_VOICE=Microsoft Zira Desktop

# --- Visuals (animated placeholder graphics) ---

# --- Rendering ---
FFMPEG_PATH=ffmpeg
KEN_BURNS=true

# --- Footage: several free sources at once (best match wins) ---
IMAGE_BACKEND=stock
STOCK_PROVIDERS=nasa,wikimedia,archive,smithsonian,pixabay,pexels
STOCK_CONTACT=you@example.com
SMITHSONIAN_API_KEY=            # free: https://api.data.gov/signup/
PIXABAY_API_KEY=                # optional, keep your own key here
PEXELS_API_KEY=                 # optional
WIKIMEDIA_LICENSES=pd,cc0,by
ARCHIVE_COLLECTIONS=prelinger,nasa
